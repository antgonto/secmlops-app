# Pinned tool versions — single source of truth for all CI scripts.
# Sourced at the top of each ci/*.sh. Keeps the three platforms identical.
TRIVY_VERSION=0.74.0
COSIGN_VERSION=3.1.3
OPENGREP_VERSION=1.30.0
GITLEAKS_VERSION=8.30.1
SYFT_VERSION=1.52.0
KYVERNO_CLI_VERSION=1.19.1
PYTHON_VERSION=3.12

# Registry + services (override in CI variables per environment).
S3_ENDPOINT=${S3_ENDPOINT:-http://s3.secmlops.com:7070}
HARBOR=${HARBOR:-harbor.secmlops.com}
IMAGE=${IMAGE:-harbor.secmlops.com/mlops/serve}
SO_URL=${SO_URL:-https://secobserve.secmlops.com}
MLFLOW=${MLFLOW:-https://mlflow.secmlops.com}

# Cosign v3: key-based, offline-capable (the lab has no Sigstore/Rekor). v3 defaults to the new bundle
# format + transparency log; these flags restore explicit key-based signing without a public tlog.
COSIGN_SIGN_FLAGS="--yes --use-signing-config=false --tlog-upload=false --new-bundle-format=false"
COSIGN_VERIFY_FLAGS="--insecure-ignore-tlog"
